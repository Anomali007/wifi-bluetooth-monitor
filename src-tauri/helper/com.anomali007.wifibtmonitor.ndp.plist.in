<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.anomali007.wifibtmonitor.ndp</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/sbin/ndp</string>
		<string>-an</string>
	</array>
	<key>StartInterval</key>
	<integer>60</integer>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardOutPath</key>
	<string>@DATA_DIR@/neighbors-ndp.out</string>
	<key>StandardErrorPath</key>
	<string>/dev/null</string>
	<key>AssociatedBundleIdentifiers</key>
	<array>
		<string>com.anomali007.wifibtmonitor</string>
	</array>
</dict>
</plist>
